# Google Sheets Configuration
# Path to your Google Cloud Service Account JSON file
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
# The ID from your Google Sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Alternatively, specify the exact spreadsheet title if service account has access
GOOGLE_SHEET_TITLE=Vinted Sales & Inventory Tracker

# Vinted Configuration
VINTED_DOMAIN=vinted.com
VINTED_USERNAME=your_vinted_username
HEADLESS=true
SESSION_DIR=.session

# Webhook Server Configuration
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_SECRET=your_optional_webhook_secret_here

# Scheduler Configuration (in hours)
SYNC_INTERVAL_HOURS=6
